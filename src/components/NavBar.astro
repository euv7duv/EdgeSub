---
import { Icon } from "astro-icon/components";
---

<div class="navbar bg-base-100 shadow-sm mx-auto max-w-5xl rounded-b-box">
    <div class="flex-1">
        <a class="btn btn-ghost text-xl text-primary" href="/">EdgeSub<svg class="inline-block w-7 h-7 ml-1" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
<circle cx="32" cy="36" r="22" fill="#ff9900"/>
<polygon points="14,26 10,8 26,18" fill="#ff9900"/>
<polygon points="50,26 54,8 38,18" fill="#ff9900"/>
<polygon points="16,22 14,12 24,18" fill="#000000"/>
<polygon points="48,22 50,12 40,18" fill="#000000"/>
<circle cx="24" cy="34" r="4" fill="#000000"/>
<circle cx="40" cy="34" r="4" fill="#000000"/>
<circle cx="25.5" cy="32.5" r="1.5" fill="#ffffff"/>
<circle cx="41.5" cy="32.5" r="1.5" fill="#ffffff"/>
<path d="M28 44 Q32 48 36 44" stroke="#000000" stroke-width="2.5" fill="none" stroke-linecap="round"/>
<path d="M32 40 L30 42 L34 42 Z" fill="#000000"/>
<line x1="8" y1="38" x2="18" y2="40" stroke="#000000" stroke-width="1.5" stroke-linecap="round"/>
<line x1="8" y1="44" x2="18" y2="43" stroke="#000000" stroke-width="1.5" stroke-linecap="round"/>
<line x1="56" y1="38" x2="46" y2="40" stroke="#000000" stroke-width="1.5" stroke-linecap="round"/>
<line x1="56" y1="44" x2="46" y2="43" stroke="#000000" stroke-width="1.5" stroke-linecap="round"/>
</svg></a>
    </div>
    <div class="flex-none">
        <ul class="menu menu-horizontal px-1">
            <li>
                <details>
                    <summary><Icon name="iconoir:compress-lines" /> Shorter</summary>
                    <ul class="bg-base-100 rounded-t-none p-2">
                        <li><a href="/shorter/create/">
                            <Icon class="inline" name="iconoir:add-circle" />
                            <span>Create</span>
                        </a></li>
                        <li><a href="/shorter/edit/">
                            <Icon class="inline" name="iconoir:edit" />
                            <span>Edit</span>
                        </a></li>
                        <li><a href="/shorter/destory/">
                            <Icon class="inline" name="iconoir:trash" />
                            <span>Delete</span>
                        </a></li>
                        <li><a href="/shorter/reset-token/">
                            <Icon class="inline" name="iconoir:refresh-double" />
                            <span>Reset Token</span>
                        </a></li>
                        <li><a href="/shorter/list/">
                            <Icon class="inline" name="iconoir:list" />
                            <span>List</span>
                        </a></li>
                        <li><a href="/shorter/admin/">
                            <Icon class="inline" name="iconoir:plus" />
                            <span>Admin</span>
                        </a></li>
                    </ul>
                </details>
            </li>

            <li>
                <a
                    title="GitHub Project"
                    href="https://github.com/kobe-koto/EdgeSub"
                    >
                    <Icon name="iconoir:github" /> GitHub
                </a>
            </li>
        </ul>
    </div>
</div>
